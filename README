    <script>
        function updateDefesa() {
            const agi = parseInt(document.getElementById('attr-agi').value) || 0;
            document.getElementById('defesa-total').value = 10 + agi;
            saveData();
        }

        function rollAttribute(attrName, elementId) {
            let count = parseInt(document.getElementById(elementId).value) || 0;
            let results = [];
            let titleEl = document.getElementById('dice-title');
            let resultEl = document.getElementById('dice-result');

            if (count <= 0) {
                let d1 = Math.floor(Math.random() * 20) + 1;
                let d2 = Math.floor(Math.random() * 20) + 1;
                let worst = Math.min(d1, d2);
                titleEl.innerText = `Rolagem de ${attrName} (Atributo 0: 2d20 pior)`;
                resultEl.innerHTML = `<span class="die">${d1}</span> e <span class="die">${d2}</span> &rarr; Pior: <span class="die highest">${worst}</span>`;
                return;
            }

            for (let i = 0; i < count; i++) {
                results.push(Math.floor(Math.random() * 20) + 1);
            }

            let highest = Math.max(...results);
            titleEl.innerText = `Rolagem de ${attrName} (${count}d20)`;
            let html = '';
            let highestMarked = false;

            results.forEach(val => {
                if (val === highest && !highestMarked) {
                    html += `<span class="die highest">${val}</span> `;
                    highestMarked = true;
                } else {
                    html += `<span class="die">${val}</span> `;
                }
            });

            html += ` &rarr; <strong>Maior: ${highest}</strong>`;
            resultEl.innerHTML = html;
        }

        const fields = ['char-name', 'player-name', 'char-species', 'char-weapon', 'attr-for', 'attr-agi', 'attr-vig', 'attr-int', 'attr-pre', 'pv-current', 'pv-max', 'san-current', 'san-max', 'rc-current', 'rc-max', 'defesa-total', 'char-inventory', 'char-notes'];

        function saveData() {
            fields.forEach(id => {
                localStorage.setItem(id, document.getElementById(id).value);
            });
        }

        function loadData() {
            fields.forEach(id => {
                if(localStorage.getItem(id) !== null) {
                    document.getElementById(id).value = localStorage.getItem(id);
                }
            });
        }

        fields.forEach(id => {
            document.getElementById(id).addEventListener('input', saveData);
        });

        window.onload = loadData;
    </script>
